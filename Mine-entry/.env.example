# OCI / ITMR credentials
OCI_USERNAME=GMDC_API_USER
OCI_PASSWORD=GMDC@1234
OCI_BASE_URL=https://gmuatociexp.gmdcltd.co.in

# ANPR service (different host from OCI) + Basic Auth
ANPR_BASE_URL=http://192.168.25.79:5001
ANPR_DETECT_URL=/api/detect
ANPR_USERNAME=GMDC_API_USER
ANPR_PASSWORD=GMDC@1234

# This device's ethernet IP (sent in OCI payloads)
DEVICE_IP=192.168.10.223

# Self-hosted Flask API
API_HOST=0.0.0.0
API_PORT=8000

# MQTT broker for display
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883

# Demo mode skips real Modbus / RFID hardware
DEMO_MODE=true

# Zebra FX RFID reader cloud API (Basic Auth for localRestLogin)
RFID_USERNAME=admin
RFID_PASSWORD=change
