# GMDC Mines Weighbridge - copy to .env and adjust
DEMO_MODE=false
# Prefer device_ip from iot_configuration.json (set when checkpoint-config finishes).
# DEVICE_IP is only a fallback if the JSON field is missing.
# DEVICE_IP=192.168.10.223
API_HOST=0.0.0.0
# Port comes from checkpoint-config server.port unless overridden:
# API_PORT=8080

# Site profile: tare_wb | vadaghat_wb | gross_wb
# CHECKPOINT_TYPE=tare_wb

# Optional: override config path (default: local iot_configuration.json then checkpoint-config)
# IOT_CONFIG_PATH=...

# Voice (gated by voice.enabled + voice.validated in IoT config)
# VOICE_ENABLED=true
# VOICE_DIRECTORY=voice

# Local OCI + digitizer simulator: python demo-app/apis.py
OCI_BASE_URL=http://localhost:8001
# OCI_BASE_URL=https://gmuatociexp.gmdcltd.co.in
# OCI_USERNAME=GMDC_API_USER
# OCI_PASSWORD=GMDC@1234
# ANPR_BASE_URL=http://192.168.25.79:5001
# MIN_WEIGHT_KG=5000

# Dashboard operator login (Free Pass / Reset)
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD=gmdc@123

# Workflow timers (seconds)
POSITIONING_SEC=120
WEIGHT_CAPTURE_SEC=60
RFID_COLLECT_TIMEOUT_SEC=60
RFID_ERROR_DISPLAY_SEC=10
MANUAL_UPDATE_POLL_SEC=5
UPDATE_STATUS_2_RESET_SEC=10
EXIT_WAIT_SEC=120
BOOM_CLOSE_DELAY_SEC=10
OCI_REQUEST_TIMEOUT_SEC=15
DIGITIZER_TIMEOUT_SEC=30
SENSOR_POLL_SEC=0.3
MIN_WEIGHT_KG=5000
ANPR_ERR_2_DISPLAY_SEC=5
WEIGHT_ERROR_DISPLAY_SEC=5
WEIGHT_CONFIRM_POLL_SEC=5
MOVE_FORWARD_INTERVAL_SEC=5
